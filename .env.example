# PromptShield Environment Configuration
# Copy this file to .env to enable testing against live LLM APIs.

# Optional: Real LLM API Key (leave empty to use built-in Mock mode)
OPENAI_API_KEY=
LLM_API_KEY=

# Optional: Custom endpoint for local LLMs (e.g., Ollama, LM Studio, vLLM)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3:8b

# Demo Server Configuration
DEMO_SERVER_HOST=127.0.0.1
DEMO_SERVER_PORT=5000
